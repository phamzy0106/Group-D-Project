#playing position vs injury (MAIN FOCUS)
tab1 <- table(league_players$position, league_players$injured)
addmargins(tab1)
round(prop.table(tab1, margin = 1), 3)

chi1 <- chisq.test(tab1)
chi1
chi1$expected
round(chi1$stdres, 2)

mosaicplot(tab1, shade = TRUE, main = "position vs injury")
barplot(prop.table(tab1, 1)[,2], ylab = "proportion injured",
        main = "injury rate by position")

#training load vs injury
tab2 <- table(league_players$training_load, league_players$injured)
round(prop.table(tab2, 1), 3)
chi2 <- chisq.test(tab2)
chi2
prop.trend.test(tab2[,2], rowSums(tab2))

#previous injuries vs initial injuries
tab3 <- table(league_players$prev_injuries, league_players$injured)
chi3 <- chisq.test(tab3)
chi3
prop.trend.test(tab3[,2], rowSums(tab3))

